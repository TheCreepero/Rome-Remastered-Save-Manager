<Window x:Class="RRM_SM.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:RRM_SM.UI.Views"
        Title="Total War: ROME REMASTERED — Save Manager"
        Width="940" Height="680"
        MinWidth="750" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshBackupsCommand}"/>
        <KeyBinding Key="B" Modifiers="Control" Command="{Binding QuickBackupCommand}"/>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NamedBackupCommand}"/>
        <KeyBinding Key="R" Modifiers="Control" Command="{Binding RestoreCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <!-- Shared colors -->
        <SolidColorBrush x:Key="AccentGold" Color="#C9A84C"/>
        <SolidColorBrush x:Key="AccentRed" Color="#E06C75"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#98C379"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#61AFEF"/>
        <SolidColorBrush x:Key="PanelBg" Color="#282840"/>
        <SolidColorBrush x:Key="CardBg" Color="#2E2E48"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#B0B0D0"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#3E3E5E"/>
        <SolidColorBrush x:Key="ControlBorder" Color="#5E5E7E"/>

        <!-- Accessible High-Contrast Focus Visual -->
        <Style x:Key="AccessibleFocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Stroke="#FFD700" StrokeThickness="2" StrokeDashArray="2 2"
                                   SnapsToDevicePixels="True" Margin="-2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Button styles -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#3E3E5E"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource ControlBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,7"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource AccessibleFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#50507A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#606090"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#5A4A20"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentGold}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentGold}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#7A6A30"/>
                    <Setter Property="Foreground" Value="#FFE066"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#4A2020"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentRed}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentRed}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#6A3030"/>
                    <Setter Property="Foreground" Value="#FF9999"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ComboBox High-Contrast Accessible Styles -->
        <ControlTemplate x:Key="ComboBoxToggleButtonTemplate" TargetType="ToggleButton">
            <Grid SnapsToDevicePixels="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="26"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="Border"
                        Grid.ColumnSpan="2"
                        CornerRadius="4"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"/>
                <Path x:Name="Arrow"
                      Grid.Column="1"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Data="M 0 0 L 4 4 L 8 0 Z"
                      Fill="{StaticResource AccentGold}"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="#343458"/>
                    <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AccentGold}"/>
                    <Setter TargetName="Arrow" Property="Fill" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="#3E3E64"/>
                    <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AccentGold}"/>
                    <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource AccentGold}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Border" Property="Opacity" Value="0.5"/>
                    <Setter TargetName="Arrow" Property="Fill" Value="#888888"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="AccessibleComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource AccessibleFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="3"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#404068"/>
                                <Setter Property="TextElement.Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#50507E"/>
                                <Setter Property="TextElement.Foreground" Value="#FFD700"/>
                                <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#5E5E94"/>
                                <Setter Property="TextElement.Foreground" Value="#FFE066"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="TextElement.Foreground" Value="#707090"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccessibleComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#25253E"/>
            <Setter Property="BorderBrush" Value="{StaticResource ControlBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="8,5,26,5"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource AccessibleFocusVisual}"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource AccessibleComboBoxItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid SnapsToDevicePixels="True">
                            <ToggleButton x:Name="ToggleButton"
                                          Template="{StaticResource ComboBoxToggleButtonTemplate}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="False"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"/>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="#25253E"
                                            BorderThickness="1"
                                            BorderBrush="{StaticResource ControlBorder}"
                                            CornerRadius="4"
                                            Margin="0,2,0,0">
                                        <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                            <ItemsPresenter x:Name="ItemsPresenter"
                                                            KeyboardNavigation.DirectionalNavigation="Contained"
                                                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="DropDownBorder" Property="Height" Value="60"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox" BasedOn="{StaticResource AccessibleComboBox}"/>

        <Style TargetType="TextBox">
            <Setter Property="FocusVisualStyle" Value="{StaticResource AccessibleFocusVisual}"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="FocusVisualStyle" Value="{StaticResource AccessibleFocusVisual}"/>
        </Style>

        <!-- BoolToVisibility -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════ HEADER ═══════════ -->
        <Border Grid.Row="0" Background="#16162A" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="TOTAL WAR: ROME REMASTERED" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentGold}"/>
                    <TextBlock Text="Save Manager &amp; Backup Tool" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Launch Game Steam Button -->
                    <Button Command="{Binding LaunchGameCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Padding="10,5" Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            ToolTip="Launch Total War: ROME REMASTERED via Steam"
                            AutomationProperties.Name="Launch Game via Steam">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚔ " FontSize="12" Foreground="{StaticResource AccentGold}"/>
                            <TextBlock Text="Launch Game" FontSize="12" Foreground="{StaticResource AccentGold}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <!-- Sentinel Quick Toggle / Status Pill -->
                    <Button Command="{Binding ToggleWatcherCommand}"
                            Style="{StaticResource ActionButton}"
                            Padding="9,5" Margin="0,0,16,0"
                            VerticalAlignment="Center"
                            ToolTip="Click to toggle Autosave Sentinel (automatic background backups)"
                            AutomationProperties.Name="Toggle Autosave Sentinel">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource TextSecondary}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsWatcherRunning}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource AccentGreen}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding WatcherStatusText}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <TextBlock Text="Backups:" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding TotalBackupCount}" Foreground="{StaticResource AccentBlue}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <TextBlock Text="Total Size:" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding TotalBackupSize}" Foreground="{StaticResource AccentBlue}" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════ MAIN CONTENT (Tabs) ═══════════ -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="8,4,8,4">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="Padding" Value="14,6"/>
                    <Setter Property="FocusVisualStyle" Value="{StaticResource AccessibleFocusVisual}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" 
                                        BorderThickness="0,0,0,2" BorderBrush="Transparent" Margin="0,0,4,0">
                                    <ContentPresenter ContentSource="Header"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentGold}"/>
                                        <Setter Property="Foreground" Value="{StaticResource AccentGold}"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#2A2A44"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- ─── TAB 1: Save Vault (Backups) ─── -->
            <TabItem Header="Save Vault">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Missing save folder warning banner -->
                    <Border Grid.Row="0" Background="#3A1E1E" BorderBrush="{StaticResource AccentRed}" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding GameSaveDirExists}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⚠" Foreground="{StaticResource AccentRed}" FontWeight="Bold" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Game save folder not detected. Configure your save folder in Settings or click Auto-Detect."
                                           Foreground="#FFFFFF" FontSize="12.5" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="_Auto-Detect Now" Command="{Binding AutoDetectCommand}" Style="{StaticResource PrimaryButton}" Padding="10,4" FontSize="12"
                                    AutomationProperties.Name="Auto-Detect Game Save Directory"/>
                        </Grid>
                    </Border>

                    <!-- Action bar -->
                    <WrapPanel Grid.Row="1" Margin="0,0,0,8">
                        <Border Background="#202036" CornerRadius="4" BorderBrush="{StaticResource ControlBorder}" BorderThickness="1" Padding="8,4" Margin="0,0,6,4" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Active Campaign:" Foreground="{StaticResource AccentGold}" VerticalAlignment="Center" FontWeight="Bold" FontSize="12.5" Margin="0,0,8,0"/>
                                <ComboBox ItemsSource="{Binding ActiveCampaigns}" SelectedItem="{Binding SelectedActiveCampaign}"
                                          MinWidth="160" VerticalContentAlignment="Center"
                                          AutomationProperties.Name="Active Campaign Faction"
                                          AutomationProperties.HelpText="Select the active campaign faction for automated backup routing"/>
                            </StackPanel>
                        </Border>
                        <Button Content="⚡ _Quick Backup" Command="{Binding QuickBackupCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,6,4"
                                AutomationProperties.Name="Quick Backup"
                                AutomationProperties.HelpText="Snapshot active campaign (Alt+Q or Ctrl+B)"/>
                        <Button Content="🏷 _Named Backup" Command="{Binding NamedBackupCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,6,4"
                                AutomationProperties.Name="Named Backup"
                                AutomationProperties.HelpText="Snapshot active campaign with a custom label (Alt+N or Ctrl+N)"/>
                        <Button Content="📦 Backup _All" Command="{Binding BackupAllCampaignsCommand}" Style="{StaticResource ActionButton}" Margin="0,0,6,4"
                                AutomationProperties.Name="Backup All Campaigns"
                                AutomationProperties.HelpText="Create backup snapshots for all detected active campaigns (Alt+A)"/>
                        <Button Content="↩ _Restore Selected" Command="{Binding RestoreCommand}" Style="{StaticResource ActionButton}" Margin="0,0,6,4"
                                AutomationProperties.Name="Restore Selected Backup"
                                AutomationProperties.HelpText="Restore selected backup to game save folder (Alt+R or Enter in list)"/>
                        <Button Content="⭐ _Pin / Unpin" Command="{Binding TogglePinCommand}" CommandParameter="{Binding SelectedBackup}" Style="{StaticResource ActionButton}" Margin="0,0,6,4"
                                ToolTip="Toggle Milestone Pin (pinned saves are preserved forever and protected from auto-pruning)"/>
                        <Button Content="📝 _Edit Details" Command="{Binding EditSaveMetadataCommand}" Style="{StaticResource ActionButton}" Margin="0,0,6,4"
                                ToolTip="Edit custom title, notes, and tags for the selected save"/>
                        <Button Content="🧹 Clean _Unpinned" Command="{Binding CleanUnpinnedSentinelCommand}" Style="{StaticResource DangerButton}" Margin="0,0,6,4"
                                ToolTip="Delete unpinned Sentinel snapshots to recover disk space while keeping all pinned milestones safe"/>
                        <Button Content="🗑 _Delete" Command="{Binding DeleteBackupCommand}" Style="{StaticResource DangerButton}" Margin="0,0,6,4"
                                AutomationProperties.Name="Delete Selected Backup"
                                AutomationProperties.HelpText="Permanently delete selected backup archive (Alt+D or Delete in list)"/>
                        <Button Content="📂 _Explorer" Command="{Binding OpenSelectedInExplorerCommand}" Style="{StaticResource ActionButton}" Margin="0,0,6,4"
                                AutomationProperties.Name="Open Selected Backup in File Explorer"
                                AutomationProperties.HelpText="Reveal selected backup in Windows File Explorer (Alt+O)"/>
                        <Button Content="🔄 Re_fresh" Command="{Binding RefreshBackupsCommand}" Style="{StaticResource ActionButton}" Margin="0,0,6,4"
                                AutomationProperties.Name="Refresh Backups List"
                                AutomationProperties.HelpText="Rescan backup directory (Alt+F or F5)"/>
                    </WrapPanel>

                    <!-- Search + List -->
                    <Border Grid.Row="2" Background="{StaticResource PanelBg}" CornerRadius="6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Search & Filter bar -->
                            <Border Grid.Row="0" Padding="8,6" Background="#22223A" CornerRadius="6,6,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="🔍" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" Margin="4,0,6,0"/>
                                    <TextBox x:Name="SearchBox" Grid.Column="1"
                                             Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}"
                                             Background="#2A2A44" Foreground="#FFFFFF"
                                             BorderBrush="{StaticResource ControlBorder}" BorderThickness="1"
                                             Padding="8,5" FontSize="13"
                                             VerticalContentAlignment="Center"
                                             AutomationProperties.Name="Search Backups"
                                             AutomationProperties.HelpText="Filter backups by name, campaign, notes, or tags (Ctrl+F)"/>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0">
                                        <TextBlock Text="Filter:" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12.5" FontWeight="SemiBold"/>
                                        <ComboBox ItemsSource="{Binding VaultFilterOptions}"
                                                  SelectedItem="{Binding SelectedVaultFilter}"
                                                  MinWidth="115" VerticalContentAlignment="Center"
                                                  Margin="0,0,10,0"
                                                  AutomationProperties.Name="Filter by Save Type"/>

                                        <TextBlock Text="Campaign:" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12.5" FontWeight="SemiBold"/>
                                        <ComboBox ItemsSource="{Binding AvailableCampaignFilters}"
                                                  SelectedItem="{Binding SelectedCampaignFilter}"
                                                  MinWidth="150" VerticalContentAlignment="Center"
                                                  AutomationProperties.Name="Filter Backups by Faction"
                                                  AutomationProperties.HelpText="Filter displayed backups by faction name"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Data grid container with empty state overlay -->
                            <Grid Grid.Row="1">
                                <DataGrid x:Name="BackupsDataGrid"
                                          ItemsSource="{Binding FilteredBackups}"
                                          SelectedItem="{Binding SelectedBackup}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          SelectionMode="Single"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="None"
                                          Background="Transparent"
                                          Foreground="#FFFFFF"
                                          BorderThickness="0"
                                          RowBackground="#2A2A44"
                                          AlternatingRowBackground="#262640"
                                          FontSize="12.5"
                                          CanUserResizeRows="False"
                                          PreviewKeyDown="BackupsDataGrid_PreviewKeyDown"
                                          AutomationProperties.Name="Backups List"
                                          AutomationProperties.HelpText="List of campaign backup archives. Double-click or press Enter to restore, Delete to remove, right-click for options.">

                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="#1E1E34"/>
                                            <Setter Property="Foreground" Value="{StaticResource AccentGold}"/>
                                            <Setter Property="Padding" Value="10,6"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="FontSize" Value="12"/>
                                        </Style>
                                    </DataGrid.ColumnHeaderStyle>

                                    <DataGrid.CellStyle>
                                        <Style TargetType="DataGridCell">
                                            <Setter Property="Padding" Value="8,5"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="FocusVisualStyle" Value="{StaticResource AccessibleFocusVisual}"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="DataGridCell">
                                                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                                            <ContentPresenter VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="#404068"/>
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.CellStyle>

                                    <DataGrid.ContextMenu>
                                        <ContextMenu Background="#25253E" BorderBrush="{StaticResource ControlBorder}" Opened="ContextMenu_Opened">
                                            <MenuItem x:Name="MenuTogglePin" Header="⭐ Toggle Pinned (Milestone / Keep Forever)" Click="ContextMenu_TogglePin_Click" Foreground="#FFFFFF"/>
                                            <MenuItem x:Name="MenuEditDetails" Header="📝 Edit Title, Notes &amp; Tags..." Click="ContextMenu_EditMetadata_Click" Foreground="#FFFFFF"/>
                                            <Separator Background="{StaticResource BorderBrush}"/>
                                            <MenuItem x:Name="MenuRestore" Header="↩ Restore Selected Save..." Click="ContextMenu_Restore_Click" Foreground="#FFFFFF"/>
                                            <MenuItem x:Name="MenuOpenExplorer" Header="📂 Reveal in File Explorer" Click="ContextMenu_OpenExplorer_Click" Foreground="#FFFFFF"/>
                                            <MenuItem x:Name="MenuCopyPath" Header="📋 Copy Full Path" Click="ContextMenu_CopyPath_Click" Foreground="#FFFFFF"/>
                                            <Separator Background="{StaticResource BorderBrush}"/>
                                            <MenuItem x:Name="MenuRenameCampaign" Header="🏷 Rename Campaign..." Click="ContextMenu_RenameCampaign_Click" Foreground="#FFFFFF"/>
                                            <MenuItem x:Name="MenuMergeCampaign" Header="🔀 Merge Into Another Campaign..." Click="ContextMenu_MergeCampaign_Click" Foreground="#FFFFFF"/>
                                            <MenuItem x:Name="MenuSplitCampaign" Header="✂ Split to New Campaign..." Click="ContextMenu_SplitCampaign_Click" Foreground="#FFFFFF"/>
                                            <Separator Background="{StaticResource BorderBrush}"/>
                                            <MenuItem x:Name="MenuDelete" Header="🗑 Delete Save..." Click="ContextMenu_Delete_Click" Foreground="{StaticResource AccentRed}"/>
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>

                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow">
                                            <Setter Property="FocusVisualStyle" Value="{StaticResource AccessibleFocusVisual}"/>
                                            <EventSetter Event="MouseDoubleClick" Handler="DataGridRow_MouseDoubleClick"/>
                                            <EventSetter Event="PreviewMouseRightButtonDown" Handler="DataGridRow_PreviewMouseRightButtonDown"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="#404068"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#343458"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>

                                    <DataGrid.Columns>
                                        <!-- Pin / Favorite Column -->
                                        <DataGridTemplateColumn Header="⭐" Width="40">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding DataContext.TogglePinCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"
                                                            Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="2"
                                                            ToolTip="Click to toggle Pin (Milestone / Keep Forever)">
                                                        <TextBlock FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="☆"/>
                                                                    <Setter Property="Foreground" Value="#6A6A8A"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                                            <Setter Property="Text" Value="⭐"/>
                                                                            <Setter Property="Foreground" Value="{StaticResource AccentGold}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Button>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTextColumn Header="Turn" Binding="{Binding Turn}" Width="52"/>
                                        <DataGridTextColumn Header="Campaign / Faction" Binding="{Binding CampaignName}" Width="150"/>
                                        
                                        <!-- Name & Details Column -->
                                        <DataGridTemplateColumn Header="Name &amp; Details" Width="*" MinWidth="220" SortMemberPath="Name">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="0,2">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Border Background="#5A4A20" CornerRadius="3" Padding="5,1" Margin="0,0,6,0" VerticalAlignment="Center"
                                                                    Visibility="{Binding IsSafetyBackup, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="SAFETY" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource AccentGold}"/>
                                                            </Border>
                                                            <Border Background="#1E3A5A" CornerRadius="3" Padding="5,1" Margin="0,0,6,0" VerticalAlignment="Center"
                                                                    Visibility="{Binding IsSentinelBackup, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="🛡 SENTINEL" FontSize="9.5" FontWeight="Bold" Foreground="#61AFEF"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold"/>
                                                        </StackPanel>

                                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                            <TextBlock Text="{Binding Notes}" FontSize="10.5" Foreground="#A0A0C0" MaxWidth="280" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                                            <TextBlock Text="{Binding TagsDisplay, StringFormat='🏷 {0}'}" FontSize="10" Foreground="{StaticResource AccentGold}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding TagsDisplay}" Value="">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTextColumn Header="Date" Binding="{Binding CreatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Width="155"/>
                                        <DataGridTextColumn Header="Size" Binding="{Binding FormattedSize}" SortMemberPath="TotalSizeBytes" Width="85"/>
                                        <DataGridTextColumn Header="Format" Binding="{Binding TypeLabel}" Width="60"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- Empty State Overlay -->
                                <Border Background="Transparent" IsHitTestVisible="False"
                                        Visibility="{Binding HasNoBackups, Converter={StaticResource BoolToVis}}">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                                        <TextBlock Text="⚔" FontSize="36" HorizontalAlignment="Center" Foreground="#4A4A6A" Margin="0,0,0,8"/>
                                        <TextBlock Text="No backups found" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{StaticResource AccentGold}"/>
                                        <TextBlock Text="Select an active campaign above and click '⚡ Quick Backup' to create your first snapshot!"
                                                   FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ─── TAB 2: Chronicle & AAR ─── -->
            <TabItem Header="Campaign Chronicle (WIP)">
                <views:ChronicleTab />
            </TabItem>

            <!-- ─── TAB 3: Settings ─── -->
            <TabItem Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                    <StackPanel>

                        <!-- Game Save Directory -->
                        <Border Background="{StaticResource CardBg}" CornerRadius="6" Padding="16,12" Margin="0,0,0,10"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="GAME SAVE DIRECTORY" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource AccentGold}" Margin="0,0,0,8"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Text="{Binding GameSaveDirectory, UpdateSourceTrigger=PropertyChanged}"
                                             Background="#22223A" Foreground="#FFFFFF"
                                             BorderBrush="{StaticResource ControlBorder}" Padding="8,6" FontSize="12.5"
                                             VerticalContentAlignment="Center"
                                             AutomationProperties.Name="Game Save Directory Path"
                                             AutomationProperties.HelpText="Path to the Rome Remastered game save folder"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0">
                                        <Button Content="_Browse..." Command="{Binding BrowseSaveDirCommand}" Style="{StaticResource ActionButton}" Margin="0,0,4,0"
                                                AutomationProperties.Name="Browse Game Save Directory (Alt+B)"/>
                                        <Button Content="_Auto-Detect" Command="{Binding AutoDetectCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,4,0"
                                                AutomationProperties.Name="Auto-Detect Game Save Directory (Alt+A)"/>
                                        <Button Content="📂 Ope_n" Command="{Binding OpenSaveDirCommand}" Style="{StaticResource ActionButton}"
                                                AutomationProperties.Name="Open Game Save Directory in Explorer (Alt+N)"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Status indicator -->
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Ellipse Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource AccentRed}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding GameSaveDirExists}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource AccentGreen}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="✖ [NOT FOUND] Directory not found"/>
                                                <Setter Property="Foreground" Value="{StaticResource AccentRed}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding GameSaveDirExists}" Value="True">
                                                        <Setter Property="Text" Value="✔ [OK] Directory found and verified"/>
                                                        <Setter Property="Foreground" Value="{StaticResource AccentGreen}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Backup Directory -->
                        <Border Background="{StaticResource CardBg}" CornerRadius="6" Padding="16,12" Margin="0,0,0,10"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="BACKUP STORAGE DIRECTORY" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource AccentGold}" Margin="0,0,0,8"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Text="{Binding BackupDirectory, UpdateSourceTrigger=PropertyChanged}"
                                             Background="#22223A" Foreground="#FFFFFF"
                                             BorderBrush="{StaticResource ControlBorder}" Padding="8,6" FontSize="12.5"
                                             VerticalContentAlignment="Center"
                                             AutomationProperties.Name="Backup Storage Directory Path"
                                             AutomationProperties.HelpText="Path where backup archives and snapshots are saved"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0">
                                        <Button Content="Bro_wse..." Command="{Binding BrowseBackupDirCommand}" Style="{StaticResource ActionButton}" Margin="0,0,4,0"
                                                AutomationProperties.Name="Browse Backup Directory (Alt+W)"/>
                                        <Button Content="📂 Op_en" Command="{Binding OpenBackupDirCommand}" Style="{StaticResource ActionButton}"
                                                AutomationProperties.Name="Open Backup Directory in Explorer (Alt+E)"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Ellipse Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource AccentGold}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding BackupDirExists}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource AccentGreen}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="ℹ [INFO] Directory will be created automatically on first backup"/>
                                                <Setter Property="Foreground" Value="{StaticResource AccentGold}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding BackupDirExists}" Value="True">
                                                        <Setter Property="Text" Value="✔ [OK] Backup directory exists and verified"/>
                                                        <Setter Property="Foreground" Value="{StaticResource AccentGreen}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Backup Preferences -->
                        <Border Background="{StaticResource CardBg}" CornerRadius="6" Padding="16,12" Margin="0,0,0,10"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="BACKUP PREFERENCES" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource AccentGold}" Margin="0,0,0,10"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Backup Format:" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" FontSize="13"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <CheckBox IsChecked="{Binding CompressBackups}" VerticalAlignment="Center"
                                                  AutomationProperties.Name="Compress backups as zip archives"/>
                                        <TextBlock Text="Compress backups as .zip archives" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="6,0,0,0" FontSize="12.5"/>
                                    </StackPanel>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Max Backups to Keep:" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" FontSize="13"/>
                                    <TextBox Grid.Column="1" Width="70"
                                             Text="{Binding MaxBackupsToKeep, UpdateSourceTrigger=PropertyChanged}"
                                             Background="#22223A" Foreground="#FFFFFF"
                                             BorderBrush="{StaticResource ControlBorder}" Padding="6,4" FontSize="13"
                                             VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                             AutomationProperties.Name="Max Backups to Keep per Campaign"/>
                                    <TextBlock Grid.Column="2" Text="(0 = Unlimited per campaign)" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="12"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Automation & Desktop Integration -->
                        <Border Background="{StaticResource CardBg}" CornerRadius="6" Padding="16,12" Margin="0,0,0,10"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="AUTOMATION &amp; DESKTOP INTEGRATION" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource AccentGold}" Margin="0,0,0,10"/>

                                <!-- Autosave Sentinel Toggle -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Autosave Sentinel:" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" FontSize="13"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <CheckBox IsChecked="{Binding AutoWatcherEnabled}" VerticalAlignment="Center"
                                                  AutomationProperties.Name="Enable Autosave Sentinel background watcher"/>
                                        <TextBlock Text="Automatically backup saves when Rome Remastered writes to disk" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="6,0,0,0" FontSize="12.5"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Desktop Notifications Toggle -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Windows Notifications:" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" FontSize="13"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <CheckBox IsChecked="{Binding ShowNotifications}" VerticalAlignment="Center"
                                                  AutomationProperties.Name="Show Windows notifications on automated backup"/>
                                        <TextBlock Text="Display desktop notification when a snapshot is created" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="6,0,0,0" FontSize="12.5"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Minimize to System Tray -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="System Tray:" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" FontSize="13"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <CheckBox IsChecked="{Binding MinimizeToTray}" VerticalAlignment="Center"
                                                  AutomationProperties.Name="Minimize or close application to System Tray"/>
                                        <TextBlock Text="Keep running in system tray on close / minimize" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="6,0,0,0" FontSize="12.5"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Debounce Window -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Save Detection Buffer:" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" FontSize="13"/>
                                    <TextBox Grid.Column="1" Width="70"
                                             Text="{Binding AutoWatcherDebounceMs, UpdateSourceTrigger=PropertyChanged}"
                                             Background="#22223A" Foreground="#FFFFFF"
                                             BorderBrush="{StaticResource ControlBorder}" Padding="6,4" FontSize="13"
                                             VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                             AutomationProperties.Name="Save detection debounce buffer in milliseconds"/>
                                    <TextBlock Grid.Column="2" Text="ms (default: 1500 ms to ensure complete file write)" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="12"/>
                                </Grid>

                                <!-- Sentinel Rolling Limit -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Sentinel Rolling Limit:" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" FontSize="13"/>
                                    <TextBox Grid.Column="1" Width="70"
                                             Text="{Binding MaxSentinelBackupsToKeep, UpdateSourceTrigger=PropertyChanged}"
                                             Background="#22223A" Foreground="#FFFFFF"
                                             BorderBrush="{StaticResource ControlBorder}" Padding="6,4" FontSize="13"
                                             VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                             AutomationProperties.Name="Max Sentinel snapshots to keep per campaign"/>
                                    <TextBlock Grid.Column="2" Text="snapshots per campaign (default: 15, 0 = unlimited). Manual backups are protected." Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="12"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Save Vault Maintenance Card -->
                        <Border Background="{StaticResource CardBg}" CornerRadius="6" Padding="16,14" Margin="0,0,0,10"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="SAVE VAULT MAINTENANCE &amp; STORAGE TOOLS"
                                           Foreground="{StaticResource AccentGold}" FontSize="13.5" FontWeight="Bold" Margin="0,0,0,10"/>
                                <TextBlock Text="Manage your flat on-disk save repository, repair indexes, or migrate legacy nested backup archives."
                                           Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,12"/>

                                <WrapPanel>
                                    <Button Content="🛠 Rebuild Vault Index" Command="{Binding RebuildIndexCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,4"
                                            ToolTip="Scans all .sav files directly in the backup directory and reconstructs the vault.json manifest"/>
                                    <Button Content="📦 Migrate Legacy Folders" Command="{Binding MigrateLegacyBackupsCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,4"
                                            ToolTip="Scans for old nested backup subdirectories and imports all saves into the flat vault structure"/>
                                    <Button Content="🔄 Rebuild Campaign Assignments" Command="{Binding RebuildCampaignAssignmentsCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,4"
                                            ToolTip="Re-evaluates and clusters all vault saves by play date (14-day gap) and turn continuity (50 turns) to separate playthroughs"/>
                                    <Button Content="🧹 Clean Unpinned Sentinel Saves" Command="{Binding CleanUnpinnedSentinelCommand}" Style="{StaticResource DangerButton}" Margin="0,0,8,4"
                                            ToolTip="Removes all unpinned Sentinel snapshots to immediately reclaim storage space while preserving all pinned milestones"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Action buttons -->
                        <Border Background="{StaticResource CardBg}" CornerRadius="6" Padding="16,12" Margin="0,0,0,10"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <WrapPanel>
                                <Button Content="💾 _Save Settings" Command="{Binding SaveSettingsCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,4"
                                        AutomationProperties.Name="Save Settings (Alt+S)"/>
                                <Button Content="🔄 Reset to De_faults" Command="{Binding ResetDefaultsCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,4"
                                        AutomationProperties.Name="Reset Settings to Defaults"/>
                                <Button Content="📝 Open con_fig.json" Command="{Binding OpenConfigCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,4"
                                        AutomationProperties.Name="Open config.json configuration file in editor"/>
                            </WrapPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- ═══════════ STATUS BAR ═══════════ -->
        <Border Grid.Row="2" Background="#16162A" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           ToolTip="{Binding StatusMessage}"
                           Foreground="{StaticResource TextSecondary}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           AutomationProperties.Name="Application Status Message"
                           AutomationProperties.LiveSetting="Polite"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar Height="12" Width="90" IsIndeterminate="True"
                                 Foreground="{StaticResource AccentGold}"
                                 Background="#25253E" BorderBrush="{StaticResource BorderBrush}"
                                 Margin="0,0,8,0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                                 AutomationProperties.Name="Operation Progress Indicator"/>
                    <TextBlock Foreground="{StaticResource AccentGold}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                        Working...
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
