<Window x:Class="RRM_SM.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Total War: ROME REMASTERED — Save Manager"
        Width="920" Height="680"
        MinWidth="750" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E">

    <Window.Resources>
        <!-- Shared colors -->
        <SolidColorBrush x:Key="AccentGold" Color="#C9A84C"/>
        <SolidColorBrush x:Key="AccentRed" Color="#E06C75"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#98C379"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#61AFEF"/>
        <SolidColorBrush x:Key="PanelBg" Color="#282840"/>
        <SolidColorBrush x:Key="CardBg" Color="#2E2E48"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#E0E0F0"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#A0A0C0"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#3E3E5E"/>

        <!-- Button style -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#3E3E5E"/>
            <Setter Property="Foreground" Value="#E0E0F0"/>
            <Setter Property="BorderBrush" Value="#5E5E7E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#50507A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#606090"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#5A4A20"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentGold}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentGold}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#7A6A30"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#4A2020"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentRed}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentRed}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#6A3030"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- BoolToVisibility -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════ HEADER ═══════════ -->
        <Border Grid.Row="0" Background="#16162A" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="TOTAL WAR: ROME REMASTERED" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentGold}"/>
                    <TextBlock Text="Save Manager &amp; Backup Tool" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Backups:" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding TotalBackupCount}" Foreground="{StaticResource AccentBlue}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <TextBlock Text="Total Size:" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding TotalBackupSize}" Foreground="{StaticResource AccentBlue}" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════ MAIN CONTENT (Tabs) ═══════════ -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="8,4,8,4">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="Padding" Value="14,6"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" 
                                        BorderThickness="0,0,0,2" BorderBrush="Transparent" Margin="0,0,4,0">
                                    <ContentPresenter ContentSource="Header"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentGold}"/>
                                        <Setter Property="Foreground" Value="{StaticResource AccentGold}"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#2A2A44"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- ─── TAB 1: Backups Manager ─── -->
            <TabItem Header="⚔  Backups Manager">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Action bar -->
                    <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                        <Button Content="⚡ Quick Backup" Command="{Binding QuickBackupCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,6,4"/>
                        <Button Content="🏷 Named Backup" Command="{Binding NamedBackupCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,6,4"/>
                        <Button Content="↩ Restore Selected" Command="{Binding RestoreCommand}" Style="{StaticResource ActionButton}" Margin="0,0,6,4"/>
                        <Button Content="🗑 Delete Selected" Command="{Binding DeleteBackupCommand}" Style="{StaticResource DangerButton}" Margin="0,0,6,4"/>
                        <Button Content="📂 Open in Explorer" Command="{Binding OpenSelectedInExplorerCommand}" Style="{StaticResource ActionButton}" Margin="0,0,6,4"/>
                        <Button Content="🔄 Refresh" Command="{Binding RefreshBackupsCommand}" Style="{StaticResource ActionButton}" Margin="0,0,6,4"/>
                    </WrapPanel>

                    <!-- Search + List -->
                    <Border Grid.Row="1" Background="{StaticResource PanelBg}" CornerRadius="6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Search bar -->
                            <Border Grid.Row="0" Padding="8,6" Background="#22223A" CornerRadius="6,6,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="🔍" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" Margin="4,0,6,0"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}"
                                             Background="#2A2A44" Foreground="{StaticResource TextPrimary}"
                                             BorderThickness="0" Padding="6,4" FontSize="13"
                                             VerticalContentAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Data grid -->
                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding FilteredBackups}"
                                      SelectedItem="{Binding SelectedBackup}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="None"
                                      Background="Transparent"
                                      Foreground="{StaticResource TextPrimary}"
                                      BorderThickness="0"
                                      RowBackground="#2A2A44"
                                      AlternatingRowBackground="#262640"
                                      FontSize="12.5"
                                      CanUserResizeRows="False">

                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#1E1E34"/>
                                        <Setter Property="Foreground" Value="{StaticResource AccentGold}"/>
                                        <Setter Property="Padding" Value="10,6"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="FontSize" Value="12"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>

                                <DataGrid.CellStyle>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="Padding" Value="8,5"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="DataGridCell">
                                                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                                        <ContentPresenter VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#404068"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.CellStyle>

                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#404068"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#343458"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" MinWidth="200"/>
                                    <DataGridTextColumn Header="Date" Binding="{Binding CreatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Width="155"/>
                                    <DataGridTextColumn Header="Size" Binding="{Binding FormattedSize}" Width="90"/>
                                    <DataGridTextColumn Header="Files" Binding="{Binding FileCount}" Width="55"/>
                                    <DataGridTextColumn Header="Format" Binding="{Binding TypeLabel}" Width="65"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ─── TAB 2: Settings ─── -->
            <TabItem Header="⚙  Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                    <StackPanel>

                        <!-- Game Save Directory -->
                        <Border Background="{StaticResource CardBg}" CornerRadius="6" Padding="16,12" Margin="0,0,0,10"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="GAME SAVE DIRECTORY" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource AccentGold}" Margin="0,0,0,8"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Text="{Binding GameSaveDirectory, UpdateSourceTrigger=PropertyChanged}"
                                             Background="#22223A" Foreground="{StaticResource TextPrimary}"
                                             BorderBrush="{StaticResource BorderBrush}" Padding="8,6" FontSize="12.5"
                                             VerticalContentAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0">
                                        <Button Content="Browse..." Command="{Binding BrowseSaveDirCommand}" Style="{StaticResource ActionButton}" Margin="0,0,4,0"/>
                                        <Button Content="Auto-Detect" Command="{Binding AutoDetectCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,4,0"/>
                                        <Button Content="📂 Open" Command="{Binding OpenSaveDirCommand}" Style="{StaticResource ActionButton}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Status indicator -->
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Ellipse Width="10" Height="10" Margin="0,0,6,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource AccentRed}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding GameSaveDirExists}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource AccentGreen}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Foreground="{StaticResource TextSecondary}" FontSize="11.5">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Directory NOT found"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding GameSaveDirExists}" Value="True">
                                                        <Setter Property="Text" Value="Directory found ✔"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Backup Directory -->
                        <Border Background="{StaticResource CardBg}" CornerRadius="6" Padding="16,12" Margin="0,0,0,10"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="BACKUP STORAGE DIRECTORY" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource AccentGold}" Margin="0,0,0,8"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Text="{Binding BackupDirectory, UpdateSourceTrigger=PropertyChanged}"
                                             Background="#22223A" Foreground="{StaticResource TextPrimary}"
                                             BorderBrush="{StaticResource BorderBrush}" Padding="8,6" FontSize="12.5"
                                             VerticalContentAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0">
                                        <Button Content="Browse..." Command="{Binding BrowseBackupDirCommand}" Style="{StaticResource ActionButton}" Margin="0,0,4,0"/>
                                        <Button Content="📂 Open" Command="{Binding OpenBackupDirCommand}" Style="{StaticResource ActionButton}"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Ellipse Width="10" Height="10" Margin="0,0,6,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource AccentRed}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding BackupDirExists}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource AccentGreen}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Foreground="{StaticResource TextSecondary}" FontSize="11.5">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Directory will be created on first backup"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding BackupDirExists}" Value="True">
                                                        <Setter Property="Text" Value="Directory exists ✔"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Backup Preferences -->
                        <Border Background="{StaticResource CardBg}" CornerRadius="6" Padding="16,12" Margin="0,0,0,10"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="BACKUP PREFERENCES" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource AccentGold}" Margin="0,0,0,10"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Backup Format:" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" FontSize="13"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <CheckBox IsChecked="{Binding CompressBackups}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Compress backups as .zip archives" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="6,0,0,0" FontSize="12.5"/>
                                    </StackPanel>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Max Backups to Keep:" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" FontSize="13"/>
                                    <TextBox Grid.Column="1" Width="70"
                                             Text="{Binding MaxBackupsToKeep, UpdateSourceTrigger=PropertyChanged}"
                                             Background="#22223A" Foreground="{StaticResource TextPrimary}"
                                             BorderBrush="{StaticResource BorderBrush}" Padding="6,4" FontSize="13"
                                             VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="(0 = Unlimited)" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="12"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Action buttons -->
                        <Border Background="{StaticResource CardBg}" CornerRadius="6" Padding="16,12" Margin="0,0,0,10"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <WrapPanel>
                                <Button Content="💾 Save Settings" Command="{Binding SaveSettingsCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,4"/>
                                <Button Content="🔄 Reset to Defaults" Command="{Binding ResetDefaultsCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,4"/>
                                <Button Content="📝 Open config.json" Command="{Binding OpenConfigCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,4"/>
                            </WrapPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- ═══════════ STATUS BAR ═══════════ -->
        <Border Grid.Row="2" Background="#16162A" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" Foreground="{StaticResource TextSecondary}" FontSize="11" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                    Working...
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Window>

