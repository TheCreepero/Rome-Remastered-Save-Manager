<UserControl x:Class="RRM_SM.UI.Views.ChronicleTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="900"
             Background="Transparent">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="0,8,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header Panel -->
        <Border Grid.Row="0" Background="#2E2E48" CornerRadius="6" BorderBrush="#3E3E5E" BorderThickness="1" Padding="12" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Chronicle Campaign:" Foreground="#C9A84C" VerticalAlignment="Center" FontWeight="Bold" FontSize="13" Margin="0,0,6,0"/>
                    <Border Background="#4A3B18" CornerRadius="3" Padding="5,2" Margin="0,0,10,0" BorderBrush="#E5C07B" BorderThickness="1" VerticalAlignment="Center" ToolTip="Campaign Chronicler &amp; AAR Writer is an experimental preview feature under active development.">
                        <TextBlock Text="WIP / PREVIEW" Foreground="#E5C07B" FontWeight="Bold" FontSize="9"/>
                    </Border>
                    <ComboBox ItemsSource="{Binding AllKnownCampaigns}"
                              SelectedItem="{Binding SelectedChronicleCampaign}"
                              MinWidth="180" Height="28" VerticalContentAlignment="Center" Background="#3E3E5E" Foreground="White" BorderBrush="#5E5E7E"/>
                    <Border Background="#5A4A20" CornerRadius="4" Padding="8,4" Margin="10,0,0,0" BorderBrush="#C9A84C" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ChronicleModName}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ChronicleModName}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding ChronicleModName}" Foreground="#F5D77F" FontWeight="Bold" FontSize="11"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ChronicleStatsSummary}" Foreground="#B0B0D0" FontWeight="SemiBold" FontSize="13"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Export HTML" Command="{Binding ExportHtmlReportCommand}" Background="#5A4A20" Foreground="#C9A84C" BorderBrush="#C9A84C" BorderThickness="1" Padding="10,4" Margin="0,0,6,0" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#7A6A30"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Copy Markdown" Command="{Binding ExportMarkdownReportCommand}" Background="#3E3E5E" Foreground="White" BorderBrush="#5E5E7E" BorderThickness="1" Padding="10,4" Margin="0,0,6,0" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#50507A"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Refresh" Command="{Binding RefreshChronicleCommand}" Background="#3E3E5E" Foreground="White" BorderBrush="#5E5E7E" BorderThickness="1" Padding="10,4" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#50507A"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Timeline List -->
            <Border Grid.Column="0" Background="#282840" CornerRadius="6" BorderBrush="#3E3E5E" BorderThickness="1" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <Border Grid.Row="0" Background="#1E1E34" Padding="10,8" CornerRadius="6,6,0,0" BorderBrush="#3E3E5E" BorderThickness="0,0,0,1">
                        <TextBlock Text="Timeline Events" Foreground="#C9A84C" FontWeight="Bold" FontSize="13"/>
                    </Border>
                    
                    <ListBox Grid.Row="1" ItemsSource="{Binding ChronicleMilestones}" 
                             SelectedItem="{Binding SelectedMilestone}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Margin="4">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="Margin" Value="0,0,0,4"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="#3E3E5E" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#343458"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#404068"/>
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#C9A84C"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <Border Grid.RowSpan="2" Grid.Column="0" Background="#5A4A20" CornerRadius="12" Width="42" Height="24" VerticalAlignment="Top" Margin="0,2,10,0">
                                        <TextBlock Text="{Binding Turn, StringFormat='T{0}'}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Title}" Foreground="White" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                    
                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding InGameDate}" Foreground="#61AFEF" FontSize="11" FontWeight="SemiBold" Margin="0,0,8,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding InGameDate}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding InGameDate}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding SaveType}" Foreground="#98C379" FontSize="11" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Foreground="#B0B0D0" FontSize="11"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Right: Journal Editor -->
            <Border Grid.Column="1" Background="#282840" CornerRadius="6" BorderBrush="#3E3E5E" BorderThickness="1" Padding="16">
                <Grid>
                    <!-- DataContext will fall through, but we bind elements to SelectedMilestone -->
                    <Grid IsEnabled="{Binding SelectedMilestone, Converter={StaticResource BoolToVis}, FallbackValue=False}">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedMilestone}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Hidden"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16" VerticalAlignment="Center">
                        <TextBlock Text="Turn " Foreground="#B0B0D0" FontSize="18"/>
                        <TextBlock Text="{Binding SelectedMilestone.Turn}" Foreground="#C9A84C" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="  |  " Foreground="#5E5E7E" FontSize="18"/>
                        <TextBlock Text="{Binding SelectedMilestone.InGameDate}" Foreground="#61AFEF" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,0,1">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedMilestone.InGameDate}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedMilestone.InGameDate}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="  |  " Foreground="#5E5E7E" FontSize="18">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedMilestone.InGameDate}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedMilestone.InGameDate}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding SelectedMilestone.Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Foreground="#B0B0D0" FontSize="15" VerticalAlignment="Center" Margin="0,0,0,1"/>
                        <TextBlock Text="  |  " Foreground="#5E5E7E" FontSize="18"/>
                        <TextBlock Text="{Binding SelectedMilestone.SaveType}" Foreground="#98C379" FontSize="15" VerticalAlignment="Center" Margin="0,0,0,1"/>
                    </StackPanel>

                    <!-- Title -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,12">
                        <TextBlock Text="Event Title / Headline" Foreground="#B0B0D0" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding SelectedMilestone.Title, UpdateSourceTrigger=PropertyChanged}" 
                                 Background="#22223A" Foreground="White" BorderBrush="#5E5E7E" BorderThickness="1" 
                                 Padding="8,6" FontSize="14" FontWeight="SemiBold"/>
                    </StackPanel>

                    <!-- Notes Box -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,12">
                        <TextBlock Text="Journal Notes" Foreground="#B0B0D0" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding SelectedMilestone.PlayerNotes, UpdateSourceTrigger=PropertyChanged}" 
                                 Background="#22223A" Foreground="White" BorderBrush="#5E5E7E" BorderThickness="1" 
                                 Padding="8" FontSize="13" TextWrapping="Wrap" AcceptsReturn="True" 
                                 VerticalScrollBarVisibility="Auto" Height="250"/>
                    </StackPanel>

                    <!-- Tags (Optional placeholder for UI logic) -->
                    <StackPanel Grid.Row="3" Margin="0,0,0,16">
                        <TextBlock Text="Quick Tags" Foreground="#B0B0D0" FontSize="12" Margin="0,0,0,4"/>
                        <WrapPanel>
                            <!-- Note: Real tag functionality would bind to a list and command, here we just show static UI that might do something if implemented, or we can leave it out. For simplicity, we just have a text block instruction or a comma separated text box for tags -->
                            <TextBox Text="{Binding MilestoneTagsString, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="#22223A" Foreground="#61AFEF" BorderBrush="#5E5E7E" BorderThickness="1" 
                                     Padding="8,6" FontSize="12" Width="300" ToolTip="Comma separated tags (e.g. Battle, Economy, Crisis)"/>
                        </WrapPanel>
                    </StackPanel>

                    <!-- Save Button -->
                    <Button Grid.Row="4" Content="Save Journal Notes" Command="{Binding SaveMilestoneNotesCommand}" HorizontalAlignment="Left"
                            Background="#5A4A20" Foreground="#C9A84C" BorderBrush="#C9A84C" BorderThickness="1" Padding="16,8" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#7A6A30"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <TextBlock Text="Select an event from the timeline to view or edit notes." 
                           Foreground="#5E5E7E" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding SelectedMilestone, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
