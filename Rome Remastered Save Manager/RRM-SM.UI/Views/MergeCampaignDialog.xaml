<Window x:Class="RRM_SM.UI.Views.MergeCampaignDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Merge Campaign"
        Width="460" Height="240"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1E1E2E"
        FocusManager.FocusedElement="{Binding ElementName=TargetCampaignCombo}">

    <Window.Resources>
        <SolidColorBrush x:Key="AccentGold" Color="#C9A84C"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#5E5E7E"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#B0B0D0"/>

        <Style x:Key="AccessibleFocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Stroke="#FFD700" StrokeThickness="2" StrokeDashArray="2 2"
                                   SnapsToDevicePixels="True" Margin="-2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="MERGE CAMPAIGN"
                   Foreground="{StaticResource AccentGold}" FontSize="15" FontWeight="Bold" Margin="0,0,0,4"/>

        <TextBlock Grid.Row="1" x:Name="SourceInfoText"
                   Text="Merge all saves in this campaign into another campaign:"
                   Foreground="{StaticResource TextSecondary}" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,12"/>

        <ComboBox Grid.Row="2" x:Name="TargetCampaignCombo"
                  Background="#25253E" Foreground="#FFFFFF"
                  BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                  Padding="8,6" FontSize="13"
                  FocusVisualStyle="{StaticResource AccessibleFocusVisual}"
                  AutomationProperties.Name="Select Target Campaign"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="_Merge" Width="95" Padding="0,7" Margin="0,0,10,0"
                    Background="#5A4A20" Foreground="{StaticResource AccentGold}" BorderBrush="{StaticResource AccentGold}" BorderThickness="1"
                    Click="MergeButton_Click" IsDefault="True" Cursor="Hand"
                    FocusVisualStyle="{StaticResource AccessibleFocusVisual}"
                    AutomationProperties.Name="Confirm Merge"/>
            <Button Content="_Cancel" Width="85" Padding="0,7"
                    Background="#3E3E5E" Foreground="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    Click="CancelButton_Click" IsCancel="True" Cursor="Hand"
                    FocusVisualStyle="{StaticResource AccessibleFocusVisual}"
                    AutomationProperties.Name="Cancel Merge"/>
        </StackPanel>
    </Grid>
</Window>

